<Window x:Class="JableLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:c="clr-namespace:JableLens.App.Controls"
        Title="Jable" Width="1440" Height="900" MinWidth="760" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- 不要系统标题栏：顶部悬浮的玻璃导航条就是标题栏（拖动、双击最大化都在它上面） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="80" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <!-- 页面。全幅页面（首页、演员页）从窗口顶端开始，导航条叠在上面；其它页面从导航条下面开始 -->
        <ContentControl x:Name="Host" Focusable="False"/>

        <!-- 人机验证 / 后台读取用的浏览器（每个站一个）。平时折叠，遇到验证时铺满 -->
        <Grid x:Name="ChallengePanel" Margin="0,80,0,0" Background="{StaticResource Bg}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource AccentSoft}" Padding="56,12">
                <TextBlock x:Name="ChallengeTitle" Text="需要人机验证" FontWeight="520" FontSize="15"/>
            </Border>
            <wv2:WebView2 x:Name="ReaderView" Grid.Row="1"/>
            <wv2:WebView2 x:Name="DownloadView" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>

        <!-- 顶部导航：悬浮的毛玻璃胶囊（背后的页面模糊后透出来），标志 + 栏目，右边搜索 / 新作提醒 / 头像 / 窗口按钮 -->
        <Grid x:Name="NavBar" Height="80" VerticalAlignment="Top">
            <!-- 顶端一层很淡的压暗，亮图上胶囊边缘也清楚 -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#66000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid x:Name="NavCapsule" Margin="14,12,14,0" Height="56" VerticalAlignment="Top">
                <!-- 阴影单独一层 -->
                <Border CornerRadius="28" Background="#1C1C1E" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <!-- 玻璃：背后页面的模糊 + 深色半透明 + 细亮边（和菜单、悬停卡、详情弹窗同一种） -->
                <c:GlassBackdrop CornerRadius="28" Tint="#A61C1C1E"/>
                <Border x:Name="NavSolid" CornerRadius="28" Background="#661C1C1E" Opacity="0" IsHitTestVisible="False"/>

                <DockPanel x:Name="NavDock" Margin="20,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 窗口按钮 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="20" Background="#26FFFFFF" Margin="14,0,8,0"/>
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="OnMaximize" ToolTip="最大化" AutomationProperties.Name="最大化"/>
                        <Button Style="{StaticResource CaptionCloseBtn}" Content="&#xE8BB;" Click="OnCloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭窗口"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="SearchFrame" Width="0" Height="36" Background="#1FFFFFFF" CornerRadius="18" Opacity="0">
                                <Grid>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" KeyDown="OnSearchKey" LostKeyboardFocus="OnSearchLostFocus" Margin="38,0,12,0"
                                             VerticalAlignment="Center" AutomationProperties.Name="搜索"/>
                                    <TextBlock x:Name="SearchHint" Text="番号、标题、演员" IsHitTestVisible="False" Foreground="{StaticResource Fg3}" FontSize="14" Margin="40,0,0,1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Button x:Name="SearchIcon" Style="{StaticResource IconBtn}" Content="&#xE721;" FontSize="16" Click="OnSearchOpen" ToolTip="搜索（Ctrl+F）"
                                    AutomationProperties.Name="打开搜索" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="4,0,0,0">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE896;" FontSize="16" Click="OnDownloads" ToolTip="下载" AutomationProperties.Name="下载列表"/>
                            <Border x:Name="DownloadBadge" Background="{StaticResource Accent}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,0" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="DownloadBadgeText" FontSize="10.5" FontWeight="630" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="4,0,0,0">
                            <Button Style="{StaticResource IconBtn}" Content="&#xEA8F;" FontSize="16" Click="OnBell" ToolTip="关注演员的新作" AutomationProperties.Name="新作提醒"/>
                            <Border x:Name="FollowBadge" Background="{StaticResource Accent}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,0" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="FollowBadgeText" FontSize="10.5" FontWeight="630" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource BareBtn}" Click="OnProfile" Margin="10,0,0,0" AutomationProperties.Name="账户菜单" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F0434B" Offset="0"/>
                                        <GradientStop Color="#9B0A12" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource IconBtn}" Click="OnBack" ToolTip="返回（Alt+←）" AutomationProperties.Name="返回"
                                Content="&#xE72B;" Margin="-8,0,6,0" Visibility="Collapsed"/>
                        <Button Style="{StaticResource BareBtn}" Click="OnLogo" AutomationProperties.Name="Jable" Margin="0,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="JABLE" FontFamily="{StaticResource LogoFont}" FontSize="25" Foreground="{StaticResource Accent}"/>
                        </Button>
                        <StackPanel x:Name="NavLinks" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavLink}" Content="首页" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="home"/>
                            <RadioButton x:Name="NavTags" Style="{StaticResource NavLink}" Content="标签" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="tags"/>
                            <RadioButton Style="{StaticResource NavLink}" Content="分类" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="categories"/>
                            <RadioButton Style="{StaticResource NavLink}" Content="演员" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="performers"/>
                            <RadioButton Style="{StaticResource NavLink}" Content="封面墙" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="wall"/>
                            <RadioButton Style="{StaticResource NavLink}" Content="黄果短剧" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="drama"/>
                            <RadioButton Style="{StaticResource NavLink}" Content="我的片单" Checked="OnNav" PreviewMouseLeftButtonUp="OnNavReclick" Tag="favorites"/>
                        </StackPanel>
                        <!-- 放不下的栏目（从后往前）收进「更多」下拉 -->
                        <Button x:Name="BrowseButton" Style="{StaticResource BareBtn}" Click="OnBrowse" Visibility="Collapsed" AutomationProperties.Name="更多栏目" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="更多  &#xE70D;" FontFamily="{StaticResource IconText}" FontSize="14" FontWeight="520"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- 作品详情弹窗（Netflix 的预览窗）：压暗背景，居中一张面板，点外面或 Esc 关闭 -->
        <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#B3000000" WindowChrome.IsHitTestVisibleInChrome="True">
            <ScrollViewer x:Name="ModalScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid x:Name="ModalBackdrop" Background="Transparent" MouseLeftButtonUp="OnModalBackdrop">
                    <Grid x:Name="ModalPanel" MaxWidth="940" Margin="24,32,24,56" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                        <!-- 阴影单独一层：效果加在内容上会让整块内容每帧重新栅格化，滚动变卡 -->
                        <Border CornerRadius="24" Background="{StaticResource Panel}" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="50" ShadowDepth="12" Direction="270" Opacity="0.7" Color="Black" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Grid c:RoundClip.Radius="24">
                            <c:GlassBackdrop CornerRadius="24" Tint="#E01C1C1E"/>
                            <ContentControl x:Name="ModalHost" Focusable="False"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Width="36" Height="36" FontSize="14" Background="#80181818"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Click="OnModalClose" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭详情"/>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
