<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 颜色：Netflix 网页版 -->
    <Color x:Key="BgColor">#141414</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="#181818"/>
    <SolidColorBrush x:Key="Card" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="CardHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Line" Color="#404040"/>
    <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fg2" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="Fg3" Color="#808080"/>
    <SolidColorBrush x:Key="Accent" Color="#E50914"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#3B1416"/>
    <SolidColorBrush x:Key="Link" Color="#54B9C5"/>
    <SolidColorBrush x:Key="Chip" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="ChipOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Glass" Color="#B36D6D6E"/>
    <!-- 控件统一的浅色半透明底（按钮、下拉、输入框、chip），融进深色背景，不用边框 -->
    <SolidColorBrush x:Key="Soft" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SoftHover" Color="#33FFFFFF"/>

    <!-- 界面字体：小米 MiSans（随程序打包在 Assets/Fonts，没有时回落到微软雅黑）。字重用 Weights 里的数值 -->
    <FontFamily x:Key="UiFont">../Assets/Fonts/#MiSans, Microsoft YaHei UI, Segoe UI</FontFamily>
    <!-- Windows 11 自带的图标字体，Windows 10 回落到 MDL2 -->
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- 中文 + 图标混排（按钮里「▶ 播放」那种） -->
    <FontFamily x:Key="IconText">../Assets/Fonts/#MiSans, Microsoft YaHei UI, Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- 标志字：Netflix 那种窄粗体 -->
    <FontFamily x:Key="LogoFont">Impact, Arial Black</FontFamily>

    <!-- 不在这里设字体：窗口上设了，会继承；在这里设会盖掉图标字体 -->
    <Style TargetType="TextBlock"/>

    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
</ResourceDictionary>
