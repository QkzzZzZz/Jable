<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:JableLens.App.Controls"
                    xmlns:svc="clr-namespace:JableLens.App.Services">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      作品卡片：小圆角封面 + 两行标题 + 灰色「番号 · 时长 / 上市日」，卡片之间 12 的缝；类型、标签、演员在悬停卡（BobCard）里。
      左右各 6 的内边距 = Ui.CardInset。
    -->
    <DataTemplate x:Key="VideoCardTemplate">
        <Border Background="Transparent" Padding="6,0" Cursor="Hand" c:Motion.Appear="True">
        <StackPanel>
            <Grid c:RoundClip.Radius="12" Background="{StaticResource Card}" c:Tilt.IsEnabled="True" c:Hairline.Radius="12">
                <c:AspectBox Ratio="0.5625">
                    <Image svc:ImageLoader.DecodeWidth="420" svc:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                </c:AspectBox>
                <!-- 排行（本周热门 TOP 10）：左上角红色小标 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,2,7,3" CornerRadius="8,0,8,0" Background="{StaticResource Accent}"
                        Visibility="{Binding RankText, Converter={x:Static c:Converters.NotEmptyToVisible}}">
                    <TextBlock Text="{Binding RankText}" FontSize="12.5" FontWeight="630" Foreground="White"/>
                </Border>
                <!-- 「新作」：底部居中的红色小条（Netflix 的「最近添加」） -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="8,1,8,2" CornerRadius="3,3,0,0" Background="{StaticResource Accent}"
                        Visibility="{Binding Badge, Converter={x:Static c:Converters.NotEmptyToVisible}}">
                    <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="630" Foreground="White"/>
                </Border>
                <!-- 观看进度：灰底红条 -->
                <Border VerticalAlignment="Bottom" Height="3" Margin="12,0,12,10" Background="#80808080"
                        Visibility="{Binding Progress, Converter={x:Static c:Converters.PositiveToVisible}}">
                    <Border Background="{StaticResource Accent}" RenderTransformOrigin="0,0">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Progress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Title}" Margin="1,10,1,0" FontSize="13.5" LineHeight="19" MaxHeight="38" Foreground="#E5E5E5"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <TextBlock Text="{Binding Meta}" Margin="1,4,1,0" FontSize="12" Foreground="{StaticResource Fg3}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 封面墙：大图，同样只有图 -->
    <DataTemplate x:Key="WallCardTemplate">
        <Border Padding="6" Cursor="Hand" Background="Transparent" c:Motion.Appear="True">
            <Grid c:RoundClip.Radius="12" Background="{StaticResource Card}" c:Tilt.IsEnabled="True" c:Hairline.Radius="12">
                <c:AspectBox Ratio="0.5625">
                    <Image svc:ImageLoader.DecodeWidth="640" svc:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                </c:AspectBox>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 竖版海报（DMM 宽幅封面只取右边的正面），用于演员作品 / 关注新作 -->
    <DataTemplate x:Key="PosterCardTemplate">
        <Border Background="Transparent" Padding="6,0" Cursor="Hand" c:Motion.Appear="True">
        <StackPanel>
            <Grid c:RoundClip.Radius="12" Background="{StaticResource Card}" c:Tilt.IsEnabled="True" c:Hairline.Radius="12">
                <c:AspectBox Ratio="1.42">
                    <Image svc:ImageLoader.DecodeWidth="320" svc:ImageLoader.CropRight="0.475" svc:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                </c:AspectBox>
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="8,1,8,2" CornerRadius="3,3,0,0" Background="{StaticResource Accent}"
                        Visibility="{Binding Badge, Converter={x:Static c:Converters.NotEmptyToVisible}}">
                    <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="630" Foreground="White"/>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Title}" Margin="1,10,1,0" FontSize="13.5" LineHeight="19" MaxHeight="38" Foreground="#E5E5E5"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <TextBlock Text="{Binding Meta}" Margin="1,4,1,0" FontSize="12" Foreground="{StaticResource Fg3}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        </Border>
    </DataTemplate>


    <!-- 演员：圆形头像 + 名字 + 作品数 -->
    <DataTemplate x:Key="PerformerCardTemplate">
        <Border Background="Transparent" Padding="6,10" Cursor="Hand" c:Motion.Appear="True">
            <StackPanel>
                <Grid Width="112" Height="112" HorizontalAlignment="Center" c:HoverZoom.Scale="1.06">
                    <Ellipse Fill="{StaticResource Card}"/>
                    <TextBlock Text="{Binding Initial}" FontSize="38" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image svc:ImageLoader.DecodeWidth="224" svc:ImageLoader.Source="{Binding IconUrl}" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="56,56" RadiusX="56" RadiusY="56"/>
                        </Image.Clip>
                    </Image>
                </Grid>
                <TextBlock Text="{Binding Title}" Margin="0,12,0,2" FontSize="14.5" FontWeight="520" Foreground="#E5E5E5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Foreground="{StaticResource Fg3}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 分类方块：图 + 左下角大字 -->
    <DataTemplate x:Key="CategoryCardTemplate">
        <Border Padding="6" Background="Transparent" Cursor="Hand" c:Motion.Appear="True">
            <Grid c:RoundClip.Radius="12" Background="{StaticResource Card}" c:Tilt.IsEnabled="True" c:Hairline.Radius="12">
                <c:AspectBox Ratio="0.5625">
                    <Image svc:ImageLoader.DecodeWidth="420" svc:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                </c:AspectBox>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A000000" Offset="0"/>
                            <GradientStop Color="#D9000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                    <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="630" Foreground="White"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Foreground="#CCC"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 文字方块（类型 / 发行商）：浅色底圆角，名字 + 影片数，悬停变亮 -->
    <DataTemplate x:Key="TermCardTemplate">
        <Border Padding="6" Background="Transparent" Cursor="Hand" c:Motion.Appear="True">
            <Border x:Name="tile" CornerRadius="14" Background="#14FFFFFF" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="520" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource Fg3}"/>
                </StackPanel>
            </Border>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="Background" Value="#29FFFFFF"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      骨架屏：加载中显示的占位卡片。封面上一道柔和的斜向流光慢慢扫过（中间停一下再扫），
      文字条跟着轻轻「呼吸」；内容到了以后真卡片依次浮现（Motion.Appear）。
    -->
    <DataTemplate x:Key="SkeletonCardTemplate">
        <Border Padding="6,0">
            <StackPanel>
            <Grid c:RoundClip.Radius="12" Background="#1F1F21">
                <c:AspectBox Ratio="{Binding SkeletonRatio}">
                    <Rectangle x:Name="r1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform X="-1.2"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#001F1F21" Offset="0.25"/>
                                <GradientStop Color="#16FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#001F1F21" Offset="0.75"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </c:AspectBox>
            </Grid>
            <StackPanel x:Name="lines">
                <Border Height="12" CornerRadius="6" Background="#242426" Margin="1,14,30,0"/>
                <Border Height="12" CornerRadius="6" Background="#1F1F21" Margin="1,8,90,0"/>
                <Border Height="10" CornerRadius="5" Background="#1C1C1E" Margin="1,10,150,0"/>
            </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <EventTrigger SourceName="r1" RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="r1" Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-1.2"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.2">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.9" Value="1.2"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lines" Storyboard.TargetProperty="Opacity">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.95" Value="0.55">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="1">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
