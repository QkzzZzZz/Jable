<Application x:Class="JableLens.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JableLens.App.Controls"
             Startup="OnStartup"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/Theme.xaml"/>
                <ResourceDictionary Source="Controls/CardTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 页面大标题（Netflix 类别页那种） -->
            <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="FontWeight" Value="630"/>
            </Style>

            <!-- 小节标题（行标题同款） -->
            <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="630"/>
                <Setter Property="Foreground" Value="#E5E5E5"/>
                <Setter Property="Margin" Value="0,28,0,12"/>
            </Style>

            <!-- 没有外观的按钮（标志、头像） -->
            <Style x:Key="BareBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="c" Margin="{TemplateBinding Padding}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="c" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 圆形图标按钮（顶栏、关闭） -->
            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 窗口按钮（最小化 / 最大化）：玻璃顶栏右端的小圆角按钮 -->
            <Style x:Key="CaptionBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#D9FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 悬停卡 / 详情里的圆形描边按钮（＋、▽、♥） -->
            <Style x:Key="RoundBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="#992A2A2A"/>
                <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 白色实心圆（悬停卡里的播放） -->
            <Style x:Key="RoundPlayBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- Netflix 大按钮：白底黑字「播放」、半透明灰「更多信息」 -->
            <Style x:Key="HeroBtn" TargetType="Button">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource IconText}"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="630"/>
                <Setter Property="Padding" Value="26,10,30,10"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeroBtnGlass" TargetType="Button" BasedOn="{StaticResource HeroBtn}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource Glass}"/>
            </Style>

            <!-- 普通按钮：灰底方角 -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Soft}"/>
                <Setter Property="FontFamily" Value="{StaticResource IconText}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="520"/>
                <Setter Property="Padding" Value="16,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

            <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
            </Style>

            <!-- 文字按钮（「查看全部」、关闭等） -->
            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0,6"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="c" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 下拉按钮：浅色半透明底、圆角、无边框，融进深色背景 -->
            <Style x:Key="DropdownBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Soft}"/>
                <Setter Property="FontFamily" Value="{StaticResource IconText}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="14,7,12,7"/>
                <Setter Property="Margin" Value="0,0,10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 标题旁的切换：没有底色，像标题的一部分（「封面墙  最近更新 ⌄」），悬停才出现浅底 -->
            <Style x:Key="TitleDropdownBtn" TargetType="Button" BasedOn="{StaticResource DropdownBtn}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Padding" Value="10,4,10,4"/>
            </Style>

            <!-- 下拉菜单里的一项：悬停浅底圆角（和顶部悬浮菜单一致）；选中加粗 -->
            <Style x:Key="MenuLink" TargetType="Button">
                <Setter Property="Foreground" Value="#D9D9D9"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                    <Setter TargetName="t" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 顶部导航的栏目文字 -->
            <Style x:Key="NavLink" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#C7FFFFFF"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="nav"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- 玻璃顶栏里的胶囊：选中的那项垫一层亮一点的半透明底（不加粗，免得文字宽度跳动） -->
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="16" Padding="14,7,14,8">
                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                    <Setter TargetName="t" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                    <Setter TargetName="t" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 筛选 chip（少数地方还用：设置里的单选） -->
            <Style x:Key="ChipToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b" Background="{StaticResource Soft}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Fg}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="White"/>
                                    <Setter TargetName="c" Property="TextElement.Foreground" Value="Black"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 输入框：浅色半透明底、圆角，聚焦时一圈淡白边 -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Soft}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#59FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 没有边框的输入框（顶栏搜索框里面那个） -->
            <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 细滚动条 -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4A4A4A" CornerRadius="4" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="MinHeight" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#4A4A4A" CornerRadius="4" Margin="2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="#F22A2A2C" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 资料卡里可点的胶囊（演员、类型、标签） -->
            <Style x:Key="ChipBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#EDEDED"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#17FFFFFF" Padding="13,5,13,6"
                                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:Converters.Pill}}">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#38FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 滑块：细轨道，红色已选部分，白色圆点 -->
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Grid Background="Transparent" Height="24"><Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/></Grid>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent" Height="24"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="16" Height="16" Fill="White"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- 小卡片按钮（「继续阅读」）：浅色圆角块，悬停变亮 -->
            <Style x:Key="TileBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="14" Padding="8">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 右键 / 账户菜单：黑底半透明，白字，悬停下划线（Netflix 头像菜单） -->
            <Style TargetType="ContextMenu">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Grid MinWidth="200">
                                <c:GlassBackdrop CornerRadius="16"/>
                                <StackPanel IsItemsHost="True" Margin="6"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,8">
                                <TextBlock x:Name="t" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SoftHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
